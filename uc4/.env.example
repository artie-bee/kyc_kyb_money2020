# uc4 settings. Copy this file to .env (same folder) and fill it in.
# .env is git-ignored: your key never goes into the repository.
# The servers and tools read .env when they start - restart them after a change.
# A value here wins over the same setting in Windows. Empty values are ignored.

# --- The model: Groq ---------------------------------------------------------
LLM_PROVIDER=groq
# Paste your Groq key after the = (from https://console.groq.com/keys)
GROQ_API_KEY=

# Groq writes the "Case summary prepared for you" panel. Set to mock for the
# template summary instead (no API calls).
WALLESTER_UC4_NARRATOR=live

# Optional: a different Groq model, and the sampling temperature (default 0)
# WALLESTER_UC4_MODEL=qwen/qwen3.8-27b
# WALLESTER_UC4_TEMPERATURE=0

# --- Other providers (only if LLM_PROVIDER is set to them) -------------------
# ANTHROPIC_API_KEY=
# XAI_API_KEY=

# --- App settings (defaults shown) ---------------------------------------------
# WALLESTER_UC4_PORTAL_LINK_DAYS=14
# WALLESTER_UC4_MAX_UPLOAD_MB=10
# WALLESTER_UC4_PORTAL_URL=http://127.0.0.1:8701
# WALLESTER_UC4_VIRUS_SCANNER=mock
# WALLESTER_UC4_EXTRACTION_FOR_NEW_UPLOADS=mock_only
# WALLESTER_UC4_LIVE_READ_INTERVAL=3
